# ATLAS Slack Bot Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Slack Bot Token (starts with xoxb-)
# Get this from: api.slack.com/apps > Your App > OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Slack App-Level Token (starts with xapp-)
# Get this from: api.slack.com/apps > Your App > Basic Information > App-Level Tokens
# Must have "connections:write" scope
SLACK_APP_TOKEN=xapp-your-app-token-here

# Live data mode (default: true)
# When true, fetches real-time data from Yahoo Finance for any ticker
# When false, uses static data files from DATA_PATH
USE_LIVE_DATA=true

# FRED API Key (optional, free)
# Get one at: https://fred.stlouisfed.org/docs/api/api_key.html
# Provides better Treasury yield and credit spread data
# Without it, these are approximated from Yahoo Finance
# FRED_API_KEY=your-fred-api-key-here

# Path to static data files (only used when USE_LIVE_DATA=false)
# DATA_PATH=./data/default

# Portfolio capital for position sizing (default: 250000)
# CAPITAL=250000

# Google Gemini API Key (optional, free)
# Get one at: https://aistudio.google.com/apikey
# Enables AI follow-up Q&A in ATLAS report threads
# Without it, ATLAS works normally but without conversational follow-up
# GEMINI_API_KEY=your-gemini-api-key-here
